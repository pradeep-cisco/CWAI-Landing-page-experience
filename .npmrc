# The @harbor/* packages live in Cisco's internal Nexus, not the public
# npm registry. You need to be on the Cisco network (office or VPN) for
# `npm install` to work.
@harbor:registry=https://nexus.tesseractinternal.com/repository/dfly-npm-group
@harbor-charts:registry=https://nexus.tesseractinternal.com/repository/dfly-npm-group

# If `npm install` fails with a TLS error against the Nexus registry, your
# machine is missing the Cisco internal CA. Add it the right way — do NOT
# disable TLS verification with `strict-ssl=false`. One-time setup:
#
#   1. Export your Cisco root + intermediate CA bundle to a single PEM file
#      (e.g. ~/.certs/cisco-ca-bundle.pem).
#   2. Tell Node and npm to trust it for this and future sessions, e.g. in
#      ~/.zshrc or ~/.bashrc:
#        export NODE_EXTRA_CA_CERTS=$HOME/.certs/cisco-ca-bundle.pem
#      or globally for npm in ~/.npmrc (NOT this repo-local file):
#        cafile=/Users/you/.certs/cisco-ca-bundle.pem
#
# This keeps certificate verification on for every other npm registry you
# talk to from this repo (the default, public npm packages), and only
# trusts the Cisco CA for the internal Nexus.
