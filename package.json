{
  "name": "magnetic-boilerplate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "React 19 + Vite 8 + Harbor Elements (Magnetic) starter. Rename after scaffolding.",
  "scripts": {
    "copy-elements": "node scripts/copy-elements.mjs",
    "context:update": "node scripts/update-context.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run copy-elements && vite",
    "build": "npm run copy-elements && vite build",
    "deploy:pages": "bash scripts/publish-pages.sh",
    "preview": "vite preview",
    "vendor:update": "node scripts/update-vendor.mjs"
  },
  "dependencies": {
    "@stencil/core": "4.12.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.3",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^8.0.0"
  }
}
