{
  "name": "magnetic-boilerplate",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "React 19 + Vite 8 + Harbor Elements (Magnetic) starter. Rename after scaffolding.",
  "scripts": {
    "copy-elements": "cpy './node_modules/@harbor/elements/dist/harbor-elements/**/*' './public/harbor-elements' --parents",
    "context:update": "node scripts/update-context.mjs",
    "test": "node --test tests/telemetry.test.mjs",
    "dev": "npm run copy-elements && vite",
    "build": "npm run copy-elements && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@harbor/context": "^0.2.7",
    "@harbor/elements": "^2.18.43",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.3",
    "react-router-dom": "^7.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "vite": "^8.0.0"
  }
}
